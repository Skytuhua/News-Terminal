{
  "name": "news-terminal",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:list": "node scripts/run-playwright.mjs --list",
    "test:native:daily": "node scripts/daily-native-smoke.mjs --exe src-tauri/target/release/news-terminal.exe",
    "test:native:features": "node scripts/v05-native-smoke.mjs --exe src-tauri/target/release/news-terminal.exe",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
