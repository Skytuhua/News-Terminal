{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "News Terminal",
  "version": "0.4.0",
  "identifier": "com.newsterminal.desktop",
  "build": {"beforeDevCommand":"npm run dev", "devUrl":"http://localhost:1420", "beforeBuildCommand":"npm run build", "frontendDist":"../dist"},
  "app": {
    "windows": [],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"}
  },
  "bundle": {"active":true,"targets":["nsis"],"windows":{"webviewInstallMode":{"type":"skip"},"nsis":{"compression":"zlib"}},"icon":[],"resources":{"../resources/installer-notices/":"installer-notices/","../resources/licenses/":"licenses/","../THIRD_PARTY_NOTICES.md":"THIRD_PARTY_NOTICES.md"}}
}
