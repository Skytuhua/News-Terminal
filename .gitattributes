# Preserve upstream notice bytes used by license and installer checks.
resources/licenses/** -text
resources/installer-notices/** -text
THIRD_PARTY_NOTICES.md -text

# Keep lock-bound license inputs stable across Windows checkouts.
LICENSE text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
src-tauri/Cargo.toml text eol=lf
src-tauri/Cargo.lock text eol=lf
